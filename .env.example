# Environment variables for AI Symptom Checker
# Copy this file to .env and fill in your API keys

# Hugging Face API Token
# Get your token from: https://huggingface.co/settings/tokens
REACT_APP_HUGGING_FACE_TOKEN=your_hugging_face_token_here

# Custom AI API Endpoint (if using your own AI service)
REACT_APP_AI_API_ENDPOINT=https://your-ai-api.com/analyze

# OpenAI API Key (for GPT-based analysis)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Healthcare AI (for medical NLP)
REACT_APP_GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# IBM Watson Health API
REACT_APP_IBM_WATSON_API_KEY=your_ibm_watson_api_key_here

# Enable/Disable AI features
REACT_APP_ENABLE_AI_ANALYSIS=true

# Analysis confidence threshold (0-1)
REACT_APP_CONFIDENCE_THRESHOLD=0.6

# Maximum analysis history items to store
REACT_APP_MAX_HISTORY_ITEMS=50